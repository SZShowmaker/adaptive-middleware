# Keep deployment independent of the caller's current source directory.
set_property(GLOBAL PROPERTY AMW_DELIVERY_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
function(amw_deploy target)
  if(NOT TARGET ${target})
    message(FATAL_ERROR "amw_deploy expects an existing executable target")
  endif()
  get_property(_root GLOBAL PROPERTY AMW_DELIVERY_ROOT)
  get_property(_sdk GLOBAL PROPERTY AMW_BUNDLED_SDK)
  set(_runtime "")
  if(_sdk AND WIN32)
    file(GLOB _runtime "${_sdk}/bin/*.dll")
  elseif(_sdk)
    file(GLOB _runtime "${_sdk}/lib/*.so*")
  endif()
  if(NOT WIN32)
    set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "$ORIGIN")
    set_property(TARGET ${target} APPEND PROPERTY INSTALL_RPATH "$ORIGIN")
  endif()
  foreach(_file IN LISTS _runtime)
    add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_file}" "$<TARGET_FILE_DIR:${target}>" VERBATIM)
  endforeach()
  foreach(_lib amw_time amw_log amw_cm amw_fastdds amw_project)
    if(TARGET ${_lib})
      get_target_property(_type ${_lib} TYPE)
      if(_type STREQUAL "SHARED_LIBRARY")
        add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:${_lib}>" "$<TARGET_FILE_DIR:${target}>" VERBATIM)
        install(TARGETS ${_lib} RUNTIME DESTINATION bin LIBRARY DESTINATION bin)
      endif()
    endif()
  endforeach()
  # Runtime configuration is user-owned; never overwrite an edited deployed XML.
  add_custom_command(TARGET ${target} POST_BUILD
    COMMAND ${CMAKE_COMMAND} "-DAMW_CONFIG_SOURCE=${_root}/config/logging.xml"
      "-DAMW_CONFIG_DEST=$<TARGET_FILE_DIR:${target}>/config/logging.xml"
      -P "${_root}/cmake/CopyConfig.cmake" VERBATIM)
  install(TARGETS ${target} RUNTIME DESTINATION bin)
  if(_runtime)
    install(FILES ${_runtime} DESTINATION bin)
  endif()
  install(CODE "set(AMW_CONFIG_SOURCE \"${_root}/config/logging.xml\")\nset(AMW_CONFIG_DEST \"\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/bin/config/logging.xml\")\ninclude(\"${_root}/cmake/CopyConfig.cmake\")")
endfunction()
