include_guard(GLOBAL)
get_filename_component(_amw_package "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _amw_processor)
if(CMAKE_SYSTEM_NAME STREQUAL "Windows" AND MSVC AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND
   NOT _amw_processor MATCHES "arm|aarch" AND NOT CMAKE_GENERATOR_PLATFORM MATCHES "[Aa][Rr][Mm]")
  set(AMW_PLATFORM windows-x64)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND _amw_processor MATCHES "^(x86_64|amd64)$")
  set(AMW_PLATFORM linux-x64)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND _amw_processor MATCHES "^(aarch64|arm64)$")
  set(AMW_PLATFORM linux-arm64)
else()
  message(FATAL_ERROR "Unsupported AMW target: ${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR}/${CMAKE_CXX_COMPILER_ID}")
endif()
set(AMW_BUNDLED_SDK "${_amw_package}/dependencies/${AMW_PLATFORM}")
include("${AMW_BUNDLED_SDK}/profile.cmake")
string(REGEX MATCH "^[0-9]+" _amw_compiler_major "${CMAKE_CXX_COMPILER_VERSION}")
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL AMW_SDK_COMPILER_ID OR
   NOT _amw_compiler_major STREQUAL AMW_SDK_COMPILER_MAJOR)
  message(FATAL_ERROR "Bundled ${AMW_PLATFORM} SDK requires ${AMW_SDK_COMPILER_ID} ${AMW_SDK_COMPILER_MAJOR}.x; selected ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}. Use a matching toolchain or regenerate with a matching SDK.")
endif()
if(MSVC)
  if(CMAKE_CONFIGURATION_TYPES)
    set(CMAKE_CONFIGURATION_TYPES "Release;RelWithDebInfo;MinSizeRel" CACHE STRING "Configurations compatible with bundled release DDS SDK" FORCE)
  elseif(CMAKE_BUILD_TYPE STREQUAL "Debug")
    message(FATAL_ERROR "Bundled Windows DDS SDK uses release CRT/iterators. Select Release or provide a separately supported SDK profile.")
  endif()
  if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreadedDLL")
    message(FATAL_ERROR "Bundled Windows SDK requires CMAKE_MSVC_RUNTIME_LIBRARY=MultiThreadedDLL")
  endif()
  set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
endif()
# Do not accidentally satisfy these dependencies from a developer's machine.
foreach(_target fastdds fastcdr foonathan_memory)
  if(TARGET ${_target})
    message(FATAL_ERROR "Add src-gen before loading an external DDS SDK (${_target} already exists).")
  endif()
endforeach()
set(fastdds_DIR "${AMW_BUNDLED_SDK}/share/fastdds/cmake")
set(fastcdr_DIR "${AMW_BUNDLED_SDK}/lib/cmake/fastcdr")
if(WIN32)
  set(foonathan_memory_DIR "${AMW_BUNDLED_SDK}/share/foonathan_memory/cmake")
else()
  set(foonathan_memory_DIR "${AMW_BUNDLED_SDK}/lib/foonathan_memory/cmake")
endif()
set(fastdds_SHARED_LIBS ON)
set(fastcdr_SHARED_LIBS ON)
find_package(fastcdr 2.3.6 EXACT CONFIG REQUIRED PATHS "${fastcdr_DIR}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_package(foonathan_memory CONFIG REQUIRED PATHS "${foonathan_memory_DIR}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_package(fastdds 3.6.2.0 EXACT CONFIG REQUIRED PATHS "${fastdds_DIR}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
# SDK export macros contain TARGET_EXISTS checks. Keep imported targets visible
# to parent-directory consumers of amw::fastdds, including diagnostic programs
# that include its backend header. Otherwise Windows silently drops dllimport.
foreach(_target fastdds fastcdr foonathan_memory)
  get_target_property(_amw_imported ${_target} IMPORTED)
  if(_amw_imported)
    set_property(TARGET ${_target} PROPERTY IMPORTED_GLOBAL TRUE)
  endif()
endforeach()
set_property(GLOBAL PROPERTY AMW_BUNDLED_SDK "${AMW_BUNDLED_SDK}")
message(STATUS "AMW bundled SDK: ${AMW_PLATFORM} (${AMW_BUNDLED_SDK})")
