@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/amwTargets.cmake")
set(amw_log_FOUND TRUE)
set(amw_time_FOUND TRUE)
set(_amw_need_cm FALSE)
if(NOT amw_FIND_COMPONENTS AND @AMW_BUILD_CM@)
  set(_amw_need_cm TRUE)
endif()
foreach(_component IN LISTS amw_FIND_COMPONENTS)
  if(_component STREQUAL "cm" OR _component STREQUAL "fastdds")
    set(_amw_need_cm TRUE)
  elseif(NOT _component STREQUAL "log" AND NOT _component STREQUAL "time")
    set(amw_${_component}_FOUND FALSE)
  endif()
endforeach()
if(_amw_need_cm)
  if(@AMW_BUILD_CM@)
    find_dependency(fastdds 3.6.2.0 EXACT CONFIG)
    find_dependency(fastcdr 2.3.6 EXACT CONFIG)
    include("${CMAKE_CURRENT_LIST_DIR}/amwCmTargets.cmake")
    set(amw_cm_FOUND TRUE)
    set(amw_fastdds_FOUND TRUE)
  else()
    set(amw_cm_FOUND FALSE)
    set(amw_fastdds_FOUND FALSE)
    set(amw_NOT_FOUND_MESSAGE "This SDK was built with AMW_BUILD_CM=OFF")
  endif()
endif()
check_required_components(amw)
