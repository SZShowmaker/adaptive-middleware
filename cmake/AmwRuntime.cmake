add_library(amw_time ${AMW_RUNTIME_ROOT}/src/time.cpp)
add_library(amw::time ALIAS amw_time)
set_target_properties(amw_time PROPERTIES EXPORT_NAME time)
target_include_directories(amw_time PUBLIC $<BUILD_INTERFACE:${AMW_RUNTIME_ROOT}/include> $<INSTALL_INTERFACE:include>)
add_library(amw_log ${AMW_RUNTIME_ROOT}/src/log.cpp ${AMW_RUNTIME_ROOT}/third_party/tinyxml2/tinyxml2.cpp)
add_library(amw::log ALIAS amw_log)
set_target_properties(amw_log PROPERTIES EXPORT_NAME log)
target_include_directories(amw_log PUBLIC $<BUILD_INTERFACE:${AMW_RUNTIME_ROOT}/include> $<INSTALL_INTERFACE:include> PRIVATE "${AMW_RUNTIME_ROOT}/third_party/tinyxml2")
# Private namespace avoids symbol collisions with DDS or the application's XML parser.
target_compile_definitions(amw_log PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
target_link_libraries(amw_log PUBLIC amw_time PRIVATE Threads::Threads)
set(amw_libraries amw_time amw_log)

if(AMW_BUILD_CM)
  find_package(fastdds 3.6.2.0 EXACT REQUIRED CONFIG)
  find_package(fastcdr 2.3.6 EXACT REQUIRED CONFIG)
  add_library(amw_cm ${AMW_RUNTIME_ROOT}/src/cm.cpp)
  add_library(amw::cm ALIAS amw_cm)
  target_include_directories(amw_cm PUBLIC $<BUILD_INTERFACE:${AMW_RUNTIME_ROOT}/include> $<INSTALL_INTERFACE:include>)
  target_link_libraries(amw_cm PUBLIC Threads::Threads PRIVATE amw_log)
  add_library(amw_fastdds ${AMW_RUNTIME_ROOT}/src/fastdds_binding.cpp)
  add_library(amw::fastdds ALIAS amw_fastdds)
  target_link_libraries(amw_fastdds PUBLIC amw_cm fastdds fastcdr)
  list(APPEND amw_libraries amw_cm amw_fastdds)
endif()
foreach(target IN LISTS amw_libraries)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /utf-8)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
  endif()
endforeach()

foreach(target IN LISTS amw_libraries)
  target_compile_features(${target} PUBLIC cxx_std_17)
  set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON WINDOWS_EXPORT_ALL_SYMBOLS ON)
  if(UNIX)
    set_target_properties(${target} PROPERTIES BUILD_RPATH_USE_ORIGIN ON INSTALL_RPATH "$ORIGIN")
  endif()
endforeach()
